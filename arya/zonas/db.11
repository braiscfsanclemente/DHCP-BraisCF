$TTL 86400	; 1 day
11.168.192.in-addr.arpa. IN SOA	arya.stark.lan. root.stark.lan. (
				5          ; serial
				3600       ; refresh (1 hour)
				1800       ; retry (30 minutes)
				1209600    ; expire (2 weeks)
				86400      ; minimum (1 day)
				)
			NS	arya.stark.lan.
$TTL 1200	; 20 minutes
50.11.168.192.in-addr.arpa. PTR	cliente5.lannister.lan.
			DHCID	( AAABYf49W2+4ylXqrgU9/uRIl3+jWfzbazVwh69Z6kvP
				jZk= ) ; 0 1 32
