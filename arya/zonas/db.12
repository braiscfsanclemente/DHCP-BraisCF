$TTL    86400
@       IN      SOA     arya.stark.lan. root.stark.lan. (
                        4           ; Número de serie
                        3600        ; Actualización (Refresh)
                        1800        ; Reintento (Retry)
                        1209600     ; Caducidade (Expire)
                        86400 )     ; TTL mínimo
        
; Servidores de nomes
@       IN      NS      arya.stark.lan.
