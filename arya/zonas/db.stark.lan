$TTL    86400
@       IN      SOA     arya.stark.lan. admin.stark.lan. (
                        4           ; Número de serie
                        3600        ; Actualización (Refresh)
                        1800        ; Reintento (Retry)
                        1209600     ; Caducidade (Expire)
                        86400 )     ; TTL mínimo
        
; Servidores de nomes
@       IN      NS      arya.stark.lan.

; Rexistros A dos servidores de nomes
arya     IN      A       192.168.10.9
ned      IN      A       192.168.10.2
