          {
            "name": "routers",
            "data": "192.168.10.254"
          }
        ],
        "pools": [
          {
            "pool": "192.168.11.50 - 192.168.11.90"
          }
        ],
        "subnet": "192.168.11.0/24"
      }
    ],
    "loggers": [
      {
        "name": "kea-dhcp4",
