      }
    ],
    "subnet4": [
      {
        "id": 1,
        "option-data": [
          {
            "name": "domain-search",
            "data": "stark.lan"
          },
          {
            "name": "routers",
            "data": "192.168.10.254"
          }
        ],
        "pools": [
          {
            "pool": "192.168.10.30 - 192.168.10.32"
          },
          {
            "pool": "192.168.10.101 - 192.168.10.230",
            "option-data": [
              {
                "name": "routers",
                "data": "192.168.10.253"
              }
            ]
          }
        ],
        "subnet": "192.168.10.0/24",
        "reservations": [
          {
            "hw-address": "02:42:ac:11:00:10",
            "ip-address": "192.168.10.32",
            "option-data": [
              {
                "name": "routers",
